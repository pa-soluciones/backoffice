# Copiar a .env.local para desarrollo. En Vercel se cargan en Project Settings → Environment Variables.

# Postgres (local: docker compose; producción: Neon, usar la URL "pooled")
DATABASE_URL=postgres://pas:pas@localhost:5432/pas

# Gotenberg (local: docker compose; producción: URL de Cloud Run)
GOTENBERG_URL=http://localhost:3001
GOTENBERG_USER=
GOTENBERG_PASSWORD=

# Auth (Better Auth). Secreto: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Admin inicial: se crea la primera vez que se abre /login si no hay usuarios.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Email (Resend). Sin clave, en desarrollo los emails se muestran en la consola.
RESEND_API_KEY=
EMAIL_FROM="PAS Backoffice <notificaciones@pasoluciones.com.ar>"

# Fases siguientes (ver spec/01-arquitectura.md §5)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# CRON_SECRET=
# ENCRYPTION_KEY=
